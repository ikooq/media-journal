{
  "name": "our-shelf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/database.test.ts",
    "test:hosted": "node --env-file=.env.local scripts/verify-hosted.mjs",
    "test:e2e": "playwright test",
    "db:types": "node scripts/generate-db-types.mjs",
    "format": "prettier --write app components lib types tests scripts *.ts *.mts *.mjs",
    "format:check": "prettier --check app components lib types tests scripts *.ts *.mts *.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "15.5.27",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^26.1.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.30",
    "tinypool": "2.1.2"
  }
}
