# REQUIRED — copy the project URL and publishable key from Supabase > Connect.
# Leave blank until configured. Missing configuration shows an explicit setup screen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL — server-only official YouTube Data API metadata.
# Without this, YouTube links/thumbnails still work; titles remain editable.
YOUTUBE_DATA_API_KEY=

# OPTIONAL — test runner only. Use disposable accounts and a test Supabase project.
# These are never read by the application or exposed to the browser bundle.
E2E_EMAIL=
E2E_PASSWORD=
E2E_PARTNER_EMAIL=
E2E_PARTNER_PASSWORD=
E2E_OUTSIDER_EMAIL=
E2E_OUTSIDER_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
# E2E_BROWSER_CHANNEL=msedge

# No service-role key is required or used by the application.
# NEXT_PUBLIC_SUPABASE_ENABLED was removed: configured projects always use Supabase.
